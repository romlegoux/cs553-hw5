<configuration>

<!-- Site specific YARN configuration properties -->
<property>
    <name>yarn.resourcemanager.hostname</name>
    <value>tiny</value>
  </property>

  <!-- Service qui sert les sorties des maps aux reducers (le shuffle) -->
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>

  <!-- Ce que chaque worker offre à YARN : 12 Go sur 16, et 8 vCPU -->
  <property>
    <name>yarn.nodemanager.resource.memory-mb</name>
    <value>12288</value>
  </property>
  <property>
    <name>yarn.nodemanager.resource.cpu-vcores</name>
    <value>8</value>
  </property>

  <!-- Taille minimale et maximale d'un container -->
  <property>
    <name>yarn.scheduler.minimum-allocation-mb</name>
    <value>512</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-mb</name>
    <value>12288</value>
  </property>
  <property>
    <name>yarn.scheduler.maximum-allocation-vcores</name>
    <value>8</value>
  </property>

  <!-- Fichiers intermédiaires (shuffle, spills) et logs des containers -->
  <property>
    <name>yarn.nodemanager.local-dirs</name>
    <value>/home/ubuntu/yarn/local</value>
  </property>
  <property>
    <name>yarn.nodemanager.log-dirs</name>
    <value>/home/ubuntu/yarn/logs</value>
  </property>

  <!-- Ne pas tuer les containers à cause de leur mémoire *virtuelle* -->
  <property>
    <name>yarn.nodemanager.vmem-check-enabled</name>
    <value>false</value>
  </property>

  <!-- Rassembler les logs des containers dans HDFS (commande yarn logs) -->
  <property>
    <name>yarn.log-aggregation-enable</name>
    <value>true</value>
  </property>
</configuration>
