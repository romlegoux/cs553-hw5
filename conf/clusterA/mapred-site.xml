<!-- Put site-specific property overrides in this file. -->

<configuration>
<!-- Exécuter MapReduce sur YARN (et pas en mode local) -->
  <property>
    <name>mapreduce.framework.name</name>
    <value>yarn</value>
  </property>

  <!-- Indiquer aux containers où se trouvent les classes de MapReduce -->
  <property>
    <name>yarn.app.mapreduce.am.env</name>
    <value>HADOOP_MAPRED_HOME=/home/ubuntu/hadoop-3.5.0</value>
  </property>
  <property>
    <name>mapreduce.map.env</name>
    <value>HADOOP_MAPRED_HOME=/home/ubuntu/hadoop-3.5.0</value>
  </property>
  <property>
    <name>mapreduce.reduce.env</name>
    <value>HADOOP_MAPRED_HOME=/home/ubuntu/hadoop-3.5.0</value>
  </property>

  <!-- ApplicationMaster : 1,5 Go -->
  <property>
    <name>yarn.app.mapreduce.am.resource.mb</name>
    <value>1536</value>
  </property>
  <property>
    <name>yarn.app.mapreduce.am.command-opts</name>
    <value>-Xmx1228m</value>
  </property>

  <!-- Map : 1,5 Go par tâche, donc 8 maps par worker (12 Go / 1,5 Go) = 1 par vCPU -->
  <property>
    <name>mapreduce.map.memory.mb</name>
    <value>1536</value>
  </property>
  <property>
    <name>mapreduce.map.java.opts</name>
    <value>-Xmx1228m</value>
  </property>

  <!-- Reduce : 3 Go par tâche (un reducer reçoit et fusionne beaucoup de données) -->
  <property>
    <name>mapreduce.reduce.memory.mb</name>
    <value>3072</value>
  </property>
  <property>
    <name>mapreduce.reduce.java.opts</name>
    <value>-Xmx2457m</value>
  </property>

  <!-- JobHistory server, sur tiny -->
  <property>
    <name>mapreduce.jobhistory.address</name>
    <value>tiny:10020</value>
  </property>
  <property>
    <name>mapreduce.jobhistory.webapp.address</name>
    <value>tiny:19888</value>
  </property>
</configuration>
